<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: settings and pairing come back on a new phone; the API keys stay on this phone only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
