<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "What should we watch?" opens the picker directly. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="picks"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_picks_short"
        android:shortcutLongLabel="@string/shortcut_picks_long">
        <intent
            android:action="com.home.tvremote.PICKS"
            android:targetPackage="com.home.tvremote"
            android:targetClass="com.home.tvremote.MainActivity" />
    </shortcut>
</shortcuts>
